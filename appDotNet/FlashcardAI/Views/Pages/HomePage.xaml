<Page x:Class="FlashcardAI.Views.Pages.HomePage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource CardBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="65"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="20,0">
                <TextBlock Text="🃏  Flashcard AI" FontSize="22" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="SyncStatusLbl" FontSize="12" FontStyle="Italic"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <Button x:Name="AuthBtn" Content="Login Drive" Style="{StaticResource SubtleBtn}"
                            Padding="12,6" Click="AuthBtn_Click"/>
                    <Button x:Name="SyncBtn" Content="🔄 Sync" Style="{StaticResource PrimaryBtn}"
                            Background="#3B82F6" Padding="12,6" Margin="4,0" Click="SyncBtn_Click"/>
                    <Button Content="⚙ API Keys" Style="{StaticResource SubtleBtn}"
                            Padding="12,6" Margin="4,0" Click="ApiKeys_Click"/>
                    <Button Content="+ New Scan" Style="{StaticResource PrimaryBtn}"
                            FontWeight="Bold" Padding="12,6" Margin="4,0" Click="NewScan_Click"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Active Scans (dynamic) -->
        <StackPanel x:Name="ScansPanel" Grid.Row="1" Margin="20,15,20,0" Visibility="Collapsed"/>

        <!-- Search -->
        <Border Grid.Row="2" Margin="20,10">
            <TextBox x:Name="SearchBox" Height="36" FontSize="13" Padding="10,8"
                     Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource Surface2Brush}"
                     BorderThickness="1" TextChanged="SearchBox_TextChanged">
                <TextBox.Style>
                    <Style TargetType="TextBox">
                        <Setter Property="Tag" Value="🔍  Search decks..."/>
                    </Style>
                </TextBox.Style>
            </TextBox>
        </Border>

        <!-- Deck List -->
        <ScrollViewer Grid.Row="3" Margin="20,0,20,15" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="DeckList"/>
        </ScrollViewer>
    </Grid>
</Page>
