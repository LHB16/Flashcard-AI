<Page x:Class="FlashcardAI.Views.Pages.DeckPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource CardBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="36"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="20,0">
                <TextBlock x:Name="TitleLbl" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="← Home" Style="{StaticResource SubtleBtn}" Padding="10,5" Margin="3,0" Click="Home_Click"/>
                    <Button Content="Quiz 📝" Style="{StaticResource PrimaryBtn}" Padding="10,5" Margin="3,0" Click="Quiz_Click"/>
                    <Button Content="Study ▶" Style="{StaticResource SuccessBtn}" Padding="10,5" Margin="3,0" Click="Study_Click"/>
                    <Button Content="Export Quizlet" Style="{StaticResource PrimaryBtn}" Padding="10,5" Margin="3,0" Click="Export_Click"/>
                    <Button x:Name="DedupBtn" Content="🔍 Deduplicate" Padding="10,5" Margin="3,0" Click="Dedup_Click"
                            Background="#7C3AED" Foreground="White" FontWeight="SemiBold" BorderThickness="0" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="bd" Property="Background" Value="#6D28D9"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- Stats Bar -->
        <Border Grid.Row="1" Background="{StaticResource Surface2Brush}">
            <DockPanel Margin="15,0">
                <TextBlock x:Name="StatsLbl" FontSize="12" Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
                <StackPanel x:Name="ProgressPanel" DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>
        </Border>

        <!-- Card List -->
        <ScrollViewer Grid.Row="2" Margin="15,10" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="CardList"/>
        </ScrollViewer>
    </Grid>
</Page>
