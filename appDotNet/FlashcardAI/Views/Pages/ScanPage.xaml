<Page x:Class="FlashcardAI.Views.Pages.ScanPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      Background="{StaticResource CardBgBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="60"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Background="{StaticResource SurfaceBrush}">
            <DockPanel Margin="20,0">
                <TextBlock Text="📂  Scan Images → Create Deck" FontSize="18" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <Button DockPanel.Dock="Right" Content="← Home" Style="{StaticResource SubtleBtn}"
                        Padding="12,6" Click="Back_Click" HorizontalAlignment="Right"/>
            </DockPanel>
        </Border>

        <!-- Form -->
        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" CornerRadius="12"
                Width="420" VerticalAlignment="Top" Margin="0,40,0,0" Padding="20">
            <StackPanel>
                <TextBlock Text="Create New Deck" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" Margin="0,10,0,20"/>

                <TextBlock Text="Deck Name" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,3"/>
                <TextBox x:Name="DeckNameBox" Height="36" FontSize="13" Padding="10,8"/>

                <TextBlock Text="Image Folder" FontSize="13" FontWeight="Bold"
                           Foreground="{StaticResource TextDimBrush}" Margin="0,20,0,3"/>
                <DockPanel>
                    <Button DockPanel.Dock="Right" Content="Browse" Style="{StaticResource PrimaryBtn}"
                            Padding="12,6" Click="Browse_Click"/>
                    <TextBlock x:Name="FolderLbl" Text="No folder selected" FontSize="13"
                               Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"
                               TextWrapping="Wrap" Margin="0,0,10,0"/>
                </DockPanel>
                <TextBlock x:Name="FileCountLbl" FontSize="13" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,0"/>

                <Border Background="{StaticResource Surface2Brush}" Height="1" Margin="0,25"/>

                <Button Content="▶  Select API Keys &amp; Start" Style="{StaticResource SuccessBtn}"
                        Height="42" FontSize="14" FontWeight="Bold" Click="Start_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
