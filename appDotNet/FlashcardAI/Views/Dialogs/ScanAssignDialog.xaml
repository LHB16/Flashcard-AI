<Window x:Class="FlashcardAI.Views.Dialogs.ScanAssignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="🔑 Assign API Keys for Scan" Width="500" Height="480"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource CardBgBrush}">
    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="🔑  Assign API Keys" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center"
                   Foreground="{StaticResource TextBrush}" Margin="0,10,0,3"/>
        <TextBlock Grid.Row="1" Text="Select which API keys to use for this specific scan."
                   FontSize="12" Foreground="{StaticResource TextDimBrush}" HorizontalAlignment="Center" Margin="0,0,0,10"/>

        <!-- Key list -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <StackPanel x:Name="KeyList"/>
        </ScrollViewer>

        <!-- Parallel toggle -->
        <Border Grid.Row="3" Margin="0,8">
            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ParallelCheck" Content="⚡ Parallel (1 thread/key)" FontSize="13" FontWeight="Bold"
                          Foreground="{StaticResource TextBrush}" VerticalContentAlignment="Center"/>
                <TextBlock Text="~Nx Faster" FontSize="11" Foreground="{StaticResource TextDimBrush}"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>
        </Border>

        <!-- Buttons -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,10,0,15">
            <Button Content="Cancel" Style="{StaticResource SubtleBtn}" Padding="16,8" Margin="5,0" Click="Cancel_Click"/>
            <Button Content="▶ Start Scan" Style="{StaticResource SuccessBtn}" Padding="16,8" FontWeight="Bold" Margin="5,0" Click="Start_Click"/>
        </StackPanel>
    </Grid>
</Window>
